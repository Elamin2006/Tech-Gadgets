{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": ".",
    "outDir": "dist",

    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "resolveJsonModule": true,
    "noEmitOnError": true,
    "types": ["node"]

  },
  "include": ["server.ts", "src/**/*.ts", "src/utils/apiError.ts", "src/config/corsOptions.ts", "src/utils/logger.ts", "src/models/order.model.ts"],
  "exclude": ["node_modules", "dist"]
}